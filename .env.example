# -----------------------------------------------------------------------------
# Deskcraft demo — environment variables (all optional)
# The demo runs without a database or external services; nothing is required.
# Copy to .env.local to override. Values are baked in at build time.
# -----------------------------------------------------------------------------

# Public URL of the app (metadata and links in the logged email text)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs the demo session cookie. A built-in default is used when empty.
DEMO_SESSION_SECRET=
