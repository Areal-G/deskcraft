# -----------------------------------------------------------------------------
# Deskcraft — environment variables
# Copy to .env.local and fill in. Never commit real values.
# -----------------------------------------------------------------------------

# Public URL of the app (used for Stripe redirects and auth email links)
NEXT_PUBLIC_SITE_URL=http://localhost:4107

# Supabase (local values are printed by `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56521
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# Resend — https://resend.com/api-keys
# Leave empty in development: emails are logged to the server console instead.
RESEND_API_KEY=
# Sender address. onboarding@resend.dev works for testing without a verified domain.
EMAIL_FROM="Deskcraft <onboarding@resend.dev>"

# Demo accounts created by `npm run seed:users` (local development only).
# Demo order history for the customer: scripts/seed-demo-orders.sql
DEMO_ADMIN_EMAIL=admin@deskcraft.test
DEMO_ADMIN_PASSWORD=Admin-f1d750e3
DEMO_CUSTOMER_EMAIL=customer@deskcraft.test
DEMO_CUSTOMER_PASSWORD=Customer-d1420588
